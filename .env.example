# Required. The model calls fail without it; the app still starts and reports
# the problem in plain language rather than crashing.
OPENAI_API_KEY=

# Optional. Defaults to a local SQLite file. Set this to a Postgres URL in
# deployment — a container's filesystem is ephemeral, so without it the run log
# and any saved accounts are lost on every restart.
# Paste the provider's string as-is — a `postgresql://` URL is pointed at
# psycopg 3 automatically.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
